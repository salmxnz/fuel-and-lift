# adebite web (Next.js BFF). Copy to .env.local and fill in.

# Base URL of the Go API (no trailing slash, no /v1). Server-only: the browser
# never talks to Go directly.
API_URL=http://localhost:8080

# Public URL of this Next.js app. Used to build the Google OAuth redirect URI
# (${APP_URL}/api/auth/google/callback), which must be listed under
# "Authorised redirect URIs" on the Google OAuth client.
APP_URL=http://localhost:3000

# Google OAuth Web client id (the same value as GOOGLE_CLIENT_ID in api/.env).
# The client secret lives only in the Go API.
GOOGLE_CLIENT_ID=

# HS256 secret the Go API signs access tokens with (same value as api/.env).
# Next only uses it to verify tokens locally, never to mint them.
JWT_SECRET=
