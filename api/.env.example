# --- app ---
APP_NAME="adebite"
APP_ENV=development
# The web app's public URL: invite links and the Google redirect are built from it.
APP_URL=http://localhost:3000
HTTP_ADDR=:8080
# Origins whose /api/auth/google/callback may be used as a Google redirect:
# the PWA and the admin app (admin/, port 3001). Add each callback URI to the
# Google OAuth client too.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fuel?sslmode=disable
RUN_MIGRATIONS=true

# --- auth ---
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=
ACCESS_TTL=15m
REFRESH_TTL_DAYS=60
# Google Cloud console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# These people can always sign in and are admins with Pro.
ADMIN_EMAILS=you@gmail.com

# --- AI (tried in this order, skipping any without a key) ---
AI_PROVIDERS=openrouter,anthropic
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Per user, every AI call (also for Pro: fair use).
AI_PER_MINUTE=6
AI_PER_DAY=60
# Free plan photo estimates per calendar month. Pro is unlimited.
FREE_PHOTOS_MONTHLY=10
# Total AI spend across everyone per month, USD. 0 = no cap.
AI_MONTHLY_BUDGET_USD=25
# Friends who must join through your links (and finish onboarding) for Pro forever.
REFERRALS_FOR_PRO=8

# --- Meal photos: Cloudflare R2 (S3-compatible). Leave the keys empty to turn
# photo storage off. Dashboard → R2 → Manage API tokens → "Object Read & Write"
# on this bucket. The bucket stays private: the API hands out signed links.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adebite-photos
# How long a signed photo link works.
PHOTO_URL_TTL=1h
# Photos a free user keeps (they can delete old ones). Pro is unlimited.
FREE_PHOTOS_STORED=20

# --- Web Push: generate with `make vapid` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@gmail.com

# --- Email (SMTP), e.g. Resend: smtp.resend.com, port 465, user "resend",
# password = API key. Leave SMTP_HOST empty to only log emails. ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hello@example.com
SMTP_FROM_NAME=adebite
# Where email images load from: ${EMAIL_ASSETS_URL}/email/*.png. Defaults to
# APP_URL (the web app serves web/public/email). For a public bucket, upload
# web/public/email/ under the key prefix email/, e.g. https://assets.adebite.com
EMAIL_ASSETS_URL=
