# adebite admin (Next.js BFF). Copy to .env.local and fill in.

# Base URL of the Go API (no trailing slash, no /v1). Server-only.
API_URL=http://localhost:8080

# Public URL of this app. Google redirects to ${APP_URL}/api/auth/google/callback:
# add that URI to the Google OAuth client, and this origin to the API's
# ALLOWED_ORIGINS (api/.env) so Go accepts it.
APP_URL=http://localhost:3001

# Same Google OAuth Web client id as web/ and the API.
GOOGLE_CLIENT_ID=

# Same HS256 secret as the API. Only used to verify access tokens.
JWT_SECRET=
